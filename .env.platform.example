# Copy to .env.platform on each Linux host. Keep values shell-compatible.
POSTGRES_USER=ascend_platform
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ascend_platform
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432

APP_ENV=development
TASK_ROOT=../runtime

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5173

# dev: Uvicorn reload + Vite dev server
# server: Uvicorn without reload + built frontend served by Vite preview
# static: Uvicorn without reload + built frontend served directly by Nginx
PLATFORM_MODE=dev

# Required by static mode. deploy-static publishes frontend/dist here.
FRONTEND_DEPLOY_DIR=/var/www/mskpp-aibench
NGINX_HEALTH_URL=http://127.0.0.1/elb-health
PLATFORM_PUBLIC_URL=http://mskpp-aibench.hicomputing.huawei.com

# Bootstrap/recovery account only. Add other administrators in the Permission Center.
PLATFORM_BOOTSTRAP_ADMIN_ID=admin
PLATFORM_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_WITH_8_PLUS_LETTERS_AND_DIGITS
PLATFORM_SESSION_HOURS=12
PLATFORM_SESSION_COOKIE_SECURE=false

# Raw user behavior events are retained for this many days. Set 0 to disable cleanup.
# The worker checks for expired events at startup and then at this interval.
ANALYTICS_EVENT_RETENTION_DAYS=180
ANALYTICS_CLEANUP_INTERVAL_HOURS=24

# W3 OAuth2 is disabled by default. The current test callback is HTTP; set
# PLATFORM_SESSION_COOKIE_SECURE=true together with an HTTPS redirect URI before production use.
PLATFORM_W3_OAUTH_ENABLED=false
# PLATFORM_W3_CLIENT_ID=com.huawei.it.openplatform.example
# PLATFORM_W3_CLIENT_SECRET=SET_ON_DEPLOYMENT_HOST_ONLY
# PLATFORM_W3_REDIRECT_URI=http://mskpp-aibench.hicomputing.huawei.com/api/auth/w3/callback
# PLATFORM_W3_AUTHORIZE_URL=https://uniportal.huawei.com/saaslogin1/oauth2/authorize
# PLATFORM_W3_TOKEN_URL=https://uniportal.huawei.com/saaslogin1/oauth2/accesstoken
# PLATFORM_W3_USERINFO_URL=https://uniportal.huawei.com/saaslogin1/oauth2/userinfo
# PLATFORM_W3_SCOPE=base.profile

# Community links are maintained together in PLATFORM_CONTENT_CONFIG.
# The legacy PLATFORM_COMMUNITY_* variables remain supported as a fallback for
# existing deployments whose content file does not yet configure those links.
# PLATFORM_CONTENT_CONFIG=/opt/ascend-platform/config/platform_content.yml

# Configure these paths for the deployment host. Keep the real profile file outside tracked source files.
# SIMULATOR_HOME=/opt/ascend/simulator
# SIMULATOR_PROFILES_FILE=/opt/ascend-platform/config/simulator_profiles.yml
# AIBENCH_HOME=/opt/aibench
# SST_EXECUTABLE=/opt/sst/bin/sst
# CATAPULT_HOME=/opt/ascend-platform/tools/catapult
# CATAPULT_PYTHON=/usr/bin/python3

SIM_TRACE_VIEWER_ENABLED=true
SIM_TRACE_VIEWER_CONFIG=full
SIM_TRACE_VIEWER_TIMEOUT_SECONDS=120

SIM_WORKER_ID=simulation-worker-01
SIM_MAX_CONCURRENT_TASKS=2
SIM_WORKER_POLL_INTERVAL_SECONDS=0.5
SIM_MOCK_RUN_SECONDS=6
SIM_PROGRESS_UPDATE_INTERVAL_SECONDS=3

# Set these on disconnected hosts. UV_CACHE_DIR should be an absolute path.
UV_OFFLINE=false
# UV_CACHE_DIR=/opt/ascend-platform/deploy/offline/python/current/uv-cache
