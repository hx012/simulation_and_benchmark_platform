# Copy to .env.platform on each Linux host. Keep values shell-compatible.
POSTGRES_USER=ascend_platform
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ascend_platform
POSTGRES_PORT=15432

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5173

# dev: Uvicorn reload + Vite dev server
# server: Uvicorn without reload + built frontend served by Vite preview
PLATFORM_MODE=dev
