APP_ENV=development
TASK_ROOT=../runtime
DATABASE_URL=postgresql+psycopg://ascend_platform:12345678@127.0.0.1:15432/ascend_platform

# Configure these paths only when using the real simulator or Benchmark data.
# SIMULATOR_HOME=/opt/ascend/simulator
# Verified Catapult commit: 1d18f6e11082de030c45fd55b556d15e3aa628a8
# CATAPULT_HOME=../tools/catapult
# CATAPULT_PYTHON=/usr/bin/python3

# Catapult standalone Trace Viewer generation.
SIM_TRACE_VIEWER_ENABLED=true
SIM_TRACE_VIEWER_CONFIG=full
SIM_TRACE_VIEWER_TIMEOUT_SECONDS=120
# AIBENCH_HOME=/opt/aibench
# SST_EXECUTABLE=/opt/sst/bin/sst

SIM_WORKER_ID=local-worker-01
SIM_MAX_CONCURRENT_TASKS=1
SIM_WORKER_POLL_INTERVAL_SECONDS=0.5
SIM_MOCK_RUN_SECONDS=3
SIM_PROGRESS_UPDATE_INTERVAL_SECONDS=1
